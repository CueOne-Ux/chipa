# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string. pg_trgm is created automatically on boot.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── RapidAPI: South African Grocery Prices API ───────────────────────────────
RAPIDAPI_KEY=your_key_here
RAPIDAPI_HOST=south-african-grocery-prices-api.p.rapidapi.com

# Feed caps `limit` at 50 — verified 24 July 2026. Higher values return 404.
SYNC_PAGE_SIZE=50
# Safety ceiling per run. Full catalog is ~742 pages (37k products).
SYNC_MAX_PAGES=800
SYNC_TIMEOUT_S=30

# ── Admin / cron ─────────────────────────────────────────────────────────────
# Long random string. An external scheduler posts to /api/admin/sync with it.
ADMIN_TOKEN=change_me_to_a_long_random_string

# Leave FALSE on Render's free tier: the web process sleeps after ~15 min idle
# and takes any in-process scheduler down with it. Use the external cron.
ENABLE_INTERNAL_SCHEDULER=false

# ── Basket economics ─────────────────────────────────────────────────────────
FUEL_PRICE_PER_LITRE=21.50
FUEL_CONSUMPTION_L_PER_100KM=8.0
# Minimum real saving before Chipa recommends a second stop.
MIN_SPLIT_SAVING_RAND=25.0
TIME_COST_PER_STOP_RAND=20.0

# ── Uploads / OCR ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
OCR_DPI=300
OCR_LANG=eng

# ── Matching ─────────────────────────────────────────────────────────────────
TRIGRAM_THRESHOLD=0.18
CANDIDATE_LIMIT=400

CORS_ORIGINS=*
